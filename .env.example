# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# MongoDB connection string (Optional in preview, defaults to automatic memory-backed Mongoose store if omitted)
MONGODB_URI="mongodb://localhost:27017/worknest_ajao"

# JWT Secret for candidate & founder authentication
JWT_SECRET="worknest_secret_jwt_key_pakistan_2026"

# Server Port
PORT=3000
