# Copy to .env and fill in. Never commit .env.

# MongoDB Atlas connection string. Use a NEW database name (here "worknest"):
# the old "worknest_ajao" database holds data in the previous app's shape.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/worknest?retryWrites=true&w=majority

# 64 random bytes. Generate with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# Where the frontend runs (used for CORS and password-reset links).
CLIENT_URL=http://localhost:5173
PORT=4000

# Optional: real email via https://resend.com. Without it, emails print to the API console.
RESEND_API_KEY=
MAIL_FROM=WorkNest <onboarding@resend.dev>

# Optional: "Continue with Google". Create an OAuth client ID (type "Web application") at
# https://console.cloud.google.com/apis/credentials and add your site (e.g. http://localhost:5173)
# under "Authorized JavaScript origins". Without it the Google button is hidden.
GOOGLE_CLIENT_ID=

# Optional: set to true once RESEND_API_KEY works. New sign-ups then get a verification link
# and can't apply to or publish internships until they click it. Off by default.
REQUIRE_EMAIL_VERIFICATION=false
